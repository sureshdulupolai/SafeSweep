{
  "name": "safesweep",
  "version": "1.0.0",
  "description": "Premium, offline-first, and safety-focused Windows desktop utility.",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite --force --logLevel warn",
    "build:ui": "vite build",
    "build:sidecar": "pyinstaller --clean --noconfirm --onefile --distpath sidecar-dist src-sidecar/main.py",
    "build": "npm run build:ui && npm run build:sidecar",
    "preview": "vite preview",
    "electron:start": "electron .",
    "preelectron:dev": "powershell -Command \"$p = netstat -ano | Select-String ':5173\\s' | ForEach-Object { ($_ -split '\\s+')[-1] } | Select-Object -First 1; if ($p) { taskkill /PID $p /F 2>$null }; Start-Sleep -Milliseconds 300\"",
    "electron:dev": "concurrently --prefix none \"npm run dev --silent\" \"wait-on http://localhost:5173 && electron --no-deprecation .\"",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.safesweep.app",
    "productName": "SafeSweep",
    "icon": "build/icon.ico",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "dist-ui/**/*"
    ],
    "extraResources": [
      {
        "from": "sidecar-dist",
        "to": "sidecar-dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    }
  },
  "keywords": [
    "utility",
    "cleaner",
    "offline-first",
    "privacy-focused",
    "electron"
  ],
  "author": "Suresh Polai",
  "license": "Proprietary",
  "dependencies": {
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.381.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.16.0",
    "react-window": "^1.8.10",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^30.0.9",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.11",
    "wait-on": "^7.2.0"
  }
}
